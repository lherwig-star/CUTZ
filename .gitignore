*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata

build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Info.plist wird ebenfalls aus project.yml generiert
CUTZ/Info.plist

# ── Swift Package Manager ────────────────────────────────
.swiftpm/
.build/
Packages/

